@{
    ViewData["Title"] = "Главная";
}
<link href="~/css/MainPage.css" rel="stylesheet" />
<div class="hero-modern">

    <div class="hero-left">
        <h1>
            Разрабатываем <br />
            цифровые продукты <br />
            для бизнеса
        </h1>

        <p>
            Веб-приложения, API и системы,
            которые реально решают задачи
        </p>

        <div class="hero-buttons">
            <a asp-controller="Home" asp-action="Contact" class="btn-main">
                Начать проект
            </a>

            <a asp-controller="Portfolio" asp-action="Index" class="btn-outline">
                Наши работы
            </a>
        </div>
    </div>

    <div class="hero-right">
        <div class="hero-box"></div>
        <div class="hero-box small"></div>
    </div>

</div>

<!-- БЛОК ПРОСТО ТЕКСТ -->
<div class="home-simple">
    <h2>Мы создаём решения, а не просто сайты</h2>
    <p>
        Наша команда помогает бизнесу автоматизировать процессы,
        улучшать пользовательский опыт и увеличивать прибыль
    </p>
</div>

<!-- УСЛУГИ -->
<div class="services-modern">

    <div class="service-item">
        <span>01</span>
        <h3>Разработка</h3>
        <p>Веб-приложения, API и backend системы</p>
    </div>

    <div class="service-item">
        <span>02</span>
        <h3>Интеграции</h3>
        <p>CRM, ERP и автоматизация бизнеса</p>
    </div>

    <div class="service-item">
        <span>03</span>
        <h3>Поддержка</h3>
        <p>Мониторинг и сопровождение проектов</p>
    </div>

</div>