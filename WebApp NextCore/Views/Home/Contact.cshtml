@model WebApp_NextCore.Models.FeedbackMessage
@{
    ViewData["Title"] = "Контакты";
}
<link href="~/css/Contact.css" rel="stylesheet" />
<div class="contact-wrapper">

    <div class="contact-card">

        <h2>Свяжитесь с нами</h2>
        <p class="contact-subtitle">
            Оставьте сообщение, и мы ответим вам в ближайшее время
        </p>

        @if (TempData["Message"] != null)
        {
            <div class="contact-success">
                @TempData["Message"]
            </div>
        }

        <form asp-action="Contact" method="post">
    
            <div class="form-group">
                <label>ФИО</label>
                <input asp-for="SenderName" />
                <span asp-validation-for="SenderName"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-group">
                <label>Номер Телефона</label>
                <input asp-for="Phone"/>
                <span asp-validation-for="Phone"></span>
            </div>

            <div class="form-group">
                <label>Сообщение</label>
                <textarea asp-for="Message" rows="5"></textarea>
                <span asp-validation-for="Message"></span>
            </div>

            <button type="submit" class="contact-btn">
                Отправить сообщение
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
