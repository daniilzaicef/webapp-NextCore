@model WebApp_NextCore.ViewModel.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}
<link href="~/css/Register.css" rel="stylesheet" />
<div class="login-page">

    <div class="login-card">

        <h2>Регистрация</h2>

        <form asp-action="Register" method="post">

            <div asp-validation-summary="All" class="error-box"></div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-control" placeholder="Введите email" />
            </div>

            <div class="form-group password-group">
                <label>Пароль</label>

                <div class="password-wrapper">
                    <input asp-for="Password" type="password" class="form-control" id="password" placeholder="Введите пароль" />
                    <span class="toggle-password" onclick="togglePassword('password')">👁</span>
                </div>
            </div>

            <div class="form-group password-group">
                <label>Подтверждение пароля</label>

                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassword" placeholder="Повторите пароль" />
                    <span class="toggle-password" onclick="togglePassword('confirmPassword')">👁</span>
                </div>
            </div>

            <button type="submit" class="btn-login">Зарегистрироваться</button>

            <div class="mt-3">
                <a asp-action="Login">Уже есть аккаунт? Войти</a>
            </div>

        </form>

    </div>

</div>

<script>
    function togglePassword(id) {
        const input = document.getElementById(id);

        input.type = input.type === "password" ? "text" : "password";
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
