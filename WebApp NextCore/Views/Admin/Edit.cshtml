@model VacancyModel
<h2 class="mb-4">Редактирование вакансии</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="card p-4 mb-4 shadow-sm">
        <div class="mb-3">
            <label>Название вакансии</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Описание</label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        </div>

        <div class="mb-3">
            <label>Требования</label>
            <textarea asp-for="Requirements" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary">Сохранить</button>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>


</form>