@model VacancyModel

<link href="~/css/Admin.css" rel="stylesheet" />  
<form asp-action="Edit" method="post">

    <div class="admin-card">

    <h2 class="admin-title">Редактирование вакансии</h2>

    <input type="hidden" asp-for="Id" />
    
        <div class="form-group">
            <label>Название вакансии</label>
            <input asp-for="Title" class="form-control custom-input" />
        </div>

        <div class="form-group">
            <label>Описание</label>
            <textarea asp-for="Description" class="form-control custom-input" rows="5"></textarea>
        </div>

        <div class="form-group">
            <label>Обязанности</label>
            <textarea asp-for="Responsibilities" class="form-control custom-input" rows="5"></textarea>
        </div>

        <div class="form-group">
            <label>Требования</label>
            <textarea asp-for="Requirements" class="form-control custom-input" rows="4"></textarea>
        </div>
    

    <div class="d-flex gap-2">
        <button class="btn btn-success">Сохранить</button>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
    </div>

</form>