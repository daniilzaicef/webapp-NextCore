@model IEnumerable<FeedbackMessage>

<link href="~/css/Admin.css" rel="stylesheet" />

<div class="table-wrapper">

    <h2>Сообщения с формы контактов</h2>

    <table class="custom-table">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Телефон</th>
                <th>Сообщение</th>
                <th>Дата</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="title-cell">@item.SenderName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td class="desc-cell">@item.Message</td>
                    <td>
                        <span>
                            @item.ReceivedDate.ToString("dd.MM.yyyy")
                            <br />
                            <small>@item.ReceivedDate.ToString("HH:mm")</small>
                        </span>
                    <td>
                        <a asp-action="DeleteFeedback" asp-route-id="@item.Id" class="btn-table delete">
                            Удалить
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>