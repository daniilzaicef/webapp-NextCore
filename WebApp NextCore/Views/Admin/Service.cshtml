@model IEnumerable<ServiceModel>

<link href="~/css/Admin.css" rel="stylesheet" />
<div class="table-wrapper">

    <h2>Услуги</h2>

    <a asp-action="CreateService" class="btn btn-success mb-3">
        Добавить услугу
    </a>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Описание</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="title-cell">@s.Title</td>
                    <td class="desc-cell">@s.Description</td>
                    <td>
                        <a asp-action="EditService"
                           asp-route-id="@s.Id"
                           class="btn-table edit">
                            Изменить
                        </a>

                        <a asp-action="DeleteService"
                           asp-route-id="@s.Id"
                           class="btn-table delete"
                           onclick="return confirm('Удалить услугу?')">
                            Удалить
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>