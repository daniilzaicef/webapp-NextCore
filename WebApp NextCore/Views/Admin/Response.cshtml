@model IEnumerable<VacancyResponse>

<link href="~/css/Admin.css" rel="stylesheet" />


<div class="table-wrapper">

    <h2>Отклики на вакансии</h2>

    <table class="custom-table">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Вакансия</th>
                <th>Сообщение</th>
                <th>Дата</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="title-cell">@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.VacancyTitle</td>
                    <td class="desc-cell">@item.Message</td>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="DeleteResponse" asp-route-id="@item.id"
                           onclick="return confirm('Удалить этот отклик?')"
                           class="btn-table delete">
                            Удалить
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>