@model VacancyModel

<link href="~/css/Admin.css" rel="stylesheet" />

<form asp-action="Create" method="post">
    <div class="admin-card">

        <h2 class="admin-title">Создание вакансии</h2>

        <div class="form-group">
            <label>Название</label>
            <input asp-for="Title" class="form-control custom-input" placeholder="Введите название вакансии" />
        </div>

        <div class="form-group">
            <label>Описание</label>
            <textarea asp-for="Description" class="form-control custom-input" rows="5" placeholder="Подробное описание"></textarea>
        </div>

        <div class="mb-3">
            <label>Обязанности</label>
            <textarea asp-for="Responsibilities" class="form-control custom-input" rows="3" placeholder="Введите обязанности"></textarea>
        </div>

        <div class="mb-3">
            <label>Требования</label>
            <textarea asp-for="Requirements" class="form-control custom-input" rows="2" placeholder="Введите требования"></textarea>
        </div>

    

    <div class="d-flex gap-2">
        <button class="btn btn-success">Сохранить</button>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
    </div>
</form>

