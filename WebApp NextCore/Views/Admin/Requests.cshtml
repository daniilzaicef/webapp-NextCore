@model IEnumerable<ServiceRequest>

@{
    ViewData["Title"] = "Заявки";
}
<link href="~/css/AdminRequest.css" rel="stylesheet" />
<link href="~/css/Admin.css" rel="stylesheet" />
<script src="/js/UpdateStatus.js"></script>
<div class="table-wrapper">

    <h2>Заявки пользователей</h2>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Имя</th>
                <th>Email</th>
                <th>Услуга</th>
                <th>Сообщение</th>
                <th>Дата</th>
                <th>Действия</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="title-cell">@item.Name</td>
                    <td class="title-cell">@item.Email</td>
                    <td>@item.Service?.Title</td>
                    <td class="desc-cell">@item.Message</td>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span id="status-@item.Id" class="status @item.Status.ToLower()">
                            @item.Status
                        </span>
                    </td>

                    <td>
                        <button class="btn btn-warning btn-sm"
                                onclick="updateStatus(@item.Id, 'В работе')">
                            В работу
                        </button>

                        <button class="btn btn-success btn-sm"
                                onclick="updateStatus(@item.Id, 'Завершена')">
                            Завершить
                        </button>
                    </td>

                    <td>
                        <a asp-action="DeleteRequest" asp-route-id="@item.Id"
                           onclick="return confirm('Удалить проект?')"
                           class="btn-table delete">
                            Удалить
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>