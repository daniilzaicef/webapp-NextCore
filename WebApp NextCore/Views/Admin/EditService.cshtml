@model ServiceModel

<h2>Редактировать услугу</h2>

<form asp-action="EditService" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />
    <div class="card p-4 mb-4 shadow-sm">
        <div class="mb-3">
            <label>Название</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Описание</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Полное описание</label>
            <textarea asp-for="FullDescription" class="form-control" rows="5"></textarea>
        </div>

        <div class="mb-3">
            <label>Картинка</label>
            <input type="file" name="image" class="form-control" />
        </div>
    </div>

    <button class="btn btn-outline-primary">Сохранить</button>
    <a asp-action="Service" class="btn btn-outline-primary">Назад</a>

</form>