@model IEnumerable<VacancyModel>

<h2>Вакансии</h2>

<a asp-action="Create" class="btn btn-success mb-3">Добавить</a>

<table class="table table-bordered table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Название</th>
            <th>Описание</th>
            <th></th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Изменить</a>
                <a asp-action="Delete" asp-route-id="@item.Id"
                   onclick="return confirm('Удалить проект?')"
                   class="btn btn-danger btn-sm">Удалить</a>
            </td>
        </tr>
    }
</table>
