@model IEnumerable<VacancyModel>


<link href="~/css/Vacancy.css" rel="stylesheet" />

<section class="career-hero">
    <div class="careers-title">
        <h1>Карьера в NexusCore Solution</h1>
        <p>Присоединяйтесь к команде профессионалов</p>
    </div>
</section>

<div class="corp-container">

    <div class="vacancy-grid">

        @foreach (var job in Model)
        {
            <div class="vacancy-card">

                <h3>@job.Title</h3>

                <p class="vacancy-short">
                    @job.Description
                </p>

                <div class="corp-buttons">
                    <a asp-action="Details"
                       asp-route-id="@job.Id"
                       class="btn-primary">
                        Подробнее
                    </a>

                    <a asp-action="Apply"
                       asp-route-id="@job.Id"
                       class="btn-primary">
                        Откликнуться
                    </a>
                </div>
            </div>
        }

    </div>

</div>
