@model VacancyModel
@using Markdig

<link href="~/css/Vacancy.css" rel="stylesheet" />

<div class="vacancy-wrapper">

    <!-- Верхний блок -->
    <div class="vacancy-header">
        <h1>@Model.Title</h1>
    </div>

    <div class="vacancy-content">

        <div class="vacancy-block">
            <h3>📄 Описание</h3>
            @Html.Raw(Markdown.ToHtml(Model.Description))
        </div>

        <div class="vacancy-block">
            <h3>✅ Требования</h3>
            @Html.Raw(Markdown.ToHtml(Model.Requirements))
        </div>

        <div class="vacancy-block">
            <h3>📌 Обязанности</h3>
            @Html.Raw(Markdown.ToHtml(Model.Responsibilities))
        </div>
    </div>

    

    <a asp-action="Index" class="back-btn">← Назад к вакансиям</a>

</div>