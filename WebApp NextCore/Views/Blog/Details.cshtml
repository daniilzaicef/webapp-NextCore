@model BlogPost
@using Markdig

<link href="~/css/Blog.css" rel="stylesheet" />

<div class="blog-details">

    <img src="/images/@Model.ImagePath" class="details-img" />

    <h1>@Model.Title</h1>

    <p class="blog-date">
        @Model.CreatedAt.ToString("dd MMM yyyy")
    </p>

    <p class="details-content">
        @Html.Raw(Markdown.ToHtml(Model.Content))
    </p>

    <a asp-action="Index" class="back-btn">← Назад</a>

</div>