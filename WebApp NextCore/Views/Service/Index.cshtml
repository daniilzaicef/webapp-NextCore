@model IEnumerable<ServiceModel>

@{
    ViewData["Title"] = "Услуги";
}
<link href="~/css/Service.css" rel="stylesheet" />


<div class="container mt-5">
    <!-- Заголовок -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">Наши услуги</h1>
        <p class="text-muted">
            Мы предлагаем широкий спектр IT-услуг для вашего бизнеса
        </p>
    </div>

    <form method="get" class="search-bar">
        <input type="text" name="search" placeholder="Поиск Услуг..." />
        <button type="submit">🔍</button>
    </form>

    <!-- Карточки -->
    <div class="services-grid-clean">

        @foreach (var service in Model)
        {
            <div class="service-card-accent">

                <h3>@service.Title</h3>

                <p>@service.Description</p>

                <a asp-action="Details"
                   asp-route-id="@service.Id"
                   class="service-link">
                    Подробнее →
                </a>

            </div>
        }

    </div>

</div>