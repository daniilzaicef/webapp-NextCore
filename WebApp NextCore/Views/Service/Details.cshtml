@model WebApp_NextCore.Models.ServiceModel
@using Markdig
@{
    ViewData["Title"] = Model.Title;
}

<link href="~/css/Service.css" rel="stylesheet" />

<div class="service-details-container">
    <div class="service-content">

        <div class="service-image">
            <img src="~/images/service/@Model.IamgePath" />
        </div>

        <!-- Заголовок -->
        <div class="text-center mb-4">
            <h1 class="fw-bold mt-3">@Model.Title</h1>
        </div>

        <!-- Описание -->
        <p class="service-text">
            @Html.Raw(Markdown.ToHtml(Model.Description))
        </p>

        <!-- Дополнительный текст -->
        <div class="mt-4">
            <h4>Подробное описание</h4>
            <p>
                @Html.Raw(Markdown.ToHtml(Model.FullDescription))
            </p>
        </div>

        <!-- Кнопки -->
        <div class="text-center mt-4">
            @if (User.IsInRole("User"))
            {
                <a asp-controller="ServiceRequest" asp-action="Create" asp-route-serviceId="@Model.Id"
                   class="btn btn-primary me-2">
                    Заказать услугу
                </a>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                Назад
            </a>
        </div>

    </div>

</div>