@model ProjectModel
@using Markdig

<link href="~/css/Portfolio.css" rel="stylesheet" />

<div class="project-container">

    <!-- Заголовок -->
    <div class="project-header">

        <img src="~/images/portfolio/@Model.ImagePath" class="project-img mb-3" />

        <h1>@Model.Title</h1>
        <p class="project-sub">
            Реализованный проект компании NexusCore Solution
        </p>
    </div>

    <!-- Основной блок -->
    <div class="project-main">

        <!-- Описание -->
        <div class="project-content">
            @Html.Raw(Markdown.ToHtml(Model.Description))
        </div>

        <!-- Боковая панель -->
        <div class="project-sidebar">

            <div class="sidebar-card">
                <h4>Технологии</h4>

                @if (!string.IsNullOrEmpty(Model.Technologies))
                {
                    var techList = Model.Technologies.Split(',');
                    foreach (var tech in techList)
                    {
                        <span class="tech">@tech.Trim()</span>
                    }
                }
            </div>


        </div>

    </div>

    <!-- Кнопка назад -->
    <a asp-action="Index" class="btn-back">← Назад к портфолио</a>

</div>